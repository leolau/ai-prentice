# deploy/.env.example — Copy to deploy/.env and fill in values.
#
# Required
# ────────
# Auth key for hermes-agent API server. Generate with: openssl rand -hex 32
HERMES_API_SERVER_KEY=

# Optional — OpenClaw
# ───────────────────
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_GATEWAY_PORT=18789
# OPENCLAW_BRIDGE_PORT=18790
# OPENCLAW_GATEWAY_BIND=lan
# OPENCLAW_CONFIG_DIR=~/.openclaw
# OPENCLAW_WORKSPACE_DIR=~/.openclaw/workspace

# Optional — Hermes Agent
# ───────────────────────
# HERMES_DATA_DIR=~/.hermes
# HERMES_UID=10000
# HERMES_GID=10000
# HERMES_API_PORT=8642

# Timezone (shared by both services)
# TZ=UTC
